{
  "name": "fitcheck",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:extension": "npm run dev -w @fitcheck/extension",
    "dev:desktop": "npm run dev -w @fitcheck/desktop",
    "build": "npm run build --workspaces --if-present",
    "build:extension": "npm run build -w @fitcheck/extension",
    "build:desktop": "npm run build -w @fitcheck/desktop"
  }
}
