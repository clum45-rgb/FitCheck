# Copy this file to .env.local and fill in real values.
# .env.local is gitignored (see root .gitignore) — never commit real keys.

# OpenAI — used server-side only, for the TAG step (gpt-4o-mini).
OPENAI_API_KEY=

# Supabase — Project Settings -> API in the Supabase dashboard.
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS: server-only, never ship it to the extension.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
