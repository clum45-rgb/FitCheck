{
  "manifest_version": 3,
  "name": "FitFinder",
  "version": "0.1.0",
  "description": "Discover clothing that matches your style while you browse.",
  "permissions": ["sidePanel"],
  "action": {
    "default_title": "FitFinder"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  }
}
